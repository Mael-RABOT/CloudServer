###> symfony/framework-bundle ###
APP_ENV=prod
APP_SECRET=your-app-secret-here
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://cloud_user:your-strong-db-password@database:3306/cloud_prod?serverVersion=10.6.12&charset=utf8"
###< doctrine/doctrine-bundle ###

###> docker compose ###
MYSQL_DATABASE=symfony_prod
MYSQL_USER=symfony_user
MYSQL_PASSWORD=your-secure-password-here
MYSQL_ROOT_PASSWORD=your-root-password-here
MYSQL_VERSION=10.11
###< docker compose ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(yourdomain\.com|www\.yourdomain\.com)$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=your-jwt-passphrase-here
###< lexik/jwt-authentication-bundle ###

# Optional: Redis for caching (if you want to add it later)
# REDIS_URL=redis://localhost:6379

# Optional: Mailer configuration
# MAILER_DSN=smtp://localhost:1025